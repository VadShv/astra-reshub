generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Candidate {
  id          String   @id @default(cuid())
  login       String   @unique
  name        String?
  avatar      String?
  htmlUrl     String?
  type        String?
  bio         String?
  company     String?
  blog        String?
  location    String?
  email       String?
  twitter     String?
  publicRepos Int      @default(0)
  followers   Int      @default(0)
  following   Int      @default(0)
  createdAt   DateTime?
  source      String   @default("github")
  status      String   @default("new")
  position    String?
  note        String?
  tags        String?
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  notes       Note[]
  statusLogs  StatusLog[]

  @@index([status])
  @@index([source])
}

model Note {
  id          String   @id @default(cuid())
  candidateId String
  text        String
  authorId    String?
  createdAt   DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model StatusLog {
  id          String   @id @default(cuid())
  candidateId String
  fromStatus  String?
  toStatus    String
  changedAt   DateTime @default(now())

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

model SearchHistory {
  id        String   @id @default(cuid())
  query     String
  source    String
  filters   String?
  results   Int?
  createdAt DateTime @default(now())

  @@index([source])
  @@index([createdAt])
}
